# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local data — zone dumps, OSM extracts, DEM rasters, built routing tiles.
# None of this belongs in git; all of it is reproducible from a documented source.
/data/

# Go
/bin/
*.exe
*.test
*.out
/vendor/

# Node / frontend
node_modules/
/web/dist/
/web/.vite/
*.tsbuildinfo

# Testing
/coverage/

# Editors and OS
.DS_Store
.idea/
*.swp

# Secrets and local env
.env
.env.*
!.env.example
*.pem

# Logs
*.log
npm-debug.log*

# Agent session-local settings (permissions accrue per machine)
/.claude/settings.local.json
