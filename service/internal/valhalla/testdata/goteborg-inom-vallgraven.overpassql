/* The street network of central Göteborg (Inom Vallgraven and around it),
   for the Valhalla adapter's integration tests. README.md beside this file
   says what it is for, where it came from, and how to regenerate it. */
[out:xml][timeout:120][bbox:57.6980,11.9500,57.7120,11.9850];
(
  way["highway"];
  relation["type"="restriction"];
);
(._; >;);
out body;
